<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Deliberately NOT declared: READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE.
         The only gallery access in the app is Company Admin picking a
         product image, and react-native-image-picker's launchImageLibrary
         goes through AndroidX `PickVisualMedia` — the system photo picker —
         which hands back a per-URI grant and needs no storage permission on
         any supported API level. The library declares neither permission
         itself and checks for neither; these two were hand-added on the
         mistaken assumption that older Android needed them.

         Declaring them triggers Google Play's Photo and Video Permissions
         policy, which requires justifying why the system picker is
         insufficient. It isn't — it fully covers this use case — so the
         honest answer is to not request broad access at all. -->
    <!-- @react-native-firebase/messaging: required on Android 13+ to display
         the order-ready visible notification (specs/009-order-fcm-push-notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Deliberately NOT declared: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS.
         It was carried here for a one-tap prompt against MIUI/OEM power
         management delaying FCM delivery, but Google Play restricts the
         permission to a narrow set of app categories (alarms, VPNs, device
         management) that a food-ordering app does not fit, and declaring it
         risks rejection at review. Removed before the first Play release
         along with its native BatteryOptimizationModule, which no screen
         ever called. If OEM throttling turns out to be a real field
         problem, solve it with a high-priority FCM message or an in-app
         explainer pointing at system settings — not this permission. -->

    <!-- Hardware features are declared optional explicitly, because the
         build tooling otherwise injects them as REQUIRED and Play then
         filters the app off devices that lack them.

         screen.portrait is implied by MainActivity's
         android:screenOrientation="portrait" below. Play rejected the first
         submission over it: it excluded Chromebook/desktop, tablet and
         Android XR users. Marking it optional does NOT unlock the app — the
         activity stays portrait-locked — it only stops Play treating a
         portrait-capable display as an install requirement.

         nfc is implied by the android.permission.NFC that Razorpay's
         checkout AAR merges in. Nothing in this app uses NFC, and leaving it
         implied-required would filter out every device without an NFC
         radio. No dependency declares either feature itself, so both have to
         be stated here. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.App.SplashScreen"
        android:screenOrientation="portrait"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
