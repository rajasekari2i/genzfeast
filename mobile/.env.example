# Copy to .env and fill in real values. Expo only exposes vars prefixed
# EXPO_PUBLIC_ to client code (coding_standard.md §10) — never put a secret
# here, only values already meant to be public/embedded client-side.

# api/src/api/client.ts — where this build's backend lives.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"

# This build's Company (specs/002/003's company_id-per-branded-build
# convention — mobile/src/config/tenant.ts). Leave unset for a
# system_admin-only build, which has no Company.
EXPO_PUBLIC_COMPANY_ID="<company-uuid>"

# Razorpay's key_id (not the secret — key_id is meant to be public/client-side
# per Razorpay's own docs) — must match api/.env's RAZORPAY_KEY_ID on the
# same backend this build points at (specs/006).
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
