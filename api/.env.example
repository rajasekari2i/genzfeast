# Copy to .env and fill in real values for your environment. Never commit
# .env (coding_standard.md §10) — the repo's root .gitignore excludes it.
DATABASE_URL="postgresql://<superuser>:<password>@<host>:<port>/<database>?schema=public"

# A non-superuser, non-table-owning role the Node API (and RLS tests) connect
# as — RLS is meaningless against a superuser or the table owner, both of
# which bypass it entirely. Created by the initial migration as `app_user`.
APP_DATABASE_URL="postgresql://<app_role>:<app_role_password>@<host>:<port>/<database>?schema=public"

# HS256 signing secret for access tokens (specs/002 research.md §2) — at
# least 32 characters. A real deployment's value comes from a secret
# manager, never a literal here.
JWT_SECRET="<at-least-32-character-random-secret>"
JWT_ACCESS_TOKEN_TTL_SECONDS=1800

# Refresh-token lifetime and the consecutive-failed-login lockout threshold
# (specs/002-registration-login-jwt-auth spec.md Assumptions, FR-012).
JWT_REFRESH_TOKEN_TTL_DAYS=14
ACCOUNT_LOCK_THRESHOLD=5

# Forgot-password reset code lifetime and incorrect-attempt limit
# (specs/003-forgot-password-otp-reset spec.md Assumptions).
RESET_PASSWORD_OTP_TTL_MINUTES=10
RESET_PASSWORD_OTP_MAX_ATTEMPTS=5

# Supabase Storage, for product photo uploads (specs/004, Architecture §1).
# Optional — the app boots without these; only POST /tenant/products/:id/image
# fails until they're set. SUPABASE_SERVICE_ROLE_KEY bypasses Storage's own
# access policies server-side, so treat it like any other secret (never in
# client code, never committed). No bucket-name var — one bucket per
# Company, named by its company_id, created automatically on first upload.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Firebase Admin SDK — sends the forgot-password OTP as an FCM data-message
# push (specs/003 FR-003). Get these three from Firebase Console > Project
# Settings > Service Accounts > Generate new private key (the downloaded
# JSON's project_id/client_email/private_key fields). Optional — the app
# boots without these; NotificationsModule falls back to a logging no-op
# adapter until all three are set (see fcm-notification.adapter.ts).
FIREBASE_PROJECT_ID="<firebase-project-id>"
FIREBASE_CLIENT_EMAIL="<firebase-adminsdk>@<project-id>.iam.gserviceaccount.com"
# Paste the JSON's "private_key" value verbatim, including its literal \n
# sequences and surrounding quotes — do not manually convert them to real
# newlines here.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----\n"

# Razorpay — the platform's sole payment gateway (specs/006, UPI-only V1).
# Get RAZORPAY_KEY_ID/KEY_SECRET from Razorpay Dashboard > Settings > API
# Keys (use Test Mode keys for development). RAZORPAY_WEBHOOK_SECRET is set
# when you create the webhook under Settings > Webhooks — pointed at
# POST /payments/webhook — and must match exactly, since it's what verifies
# a webhook call really came from Razorpay. Optional — the app boots without
# these; only order placement/retry/the webhook fail clearly until set.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="<key-secret>"
RAZORPAY_WEBHOOK_SECRET="<webhook-secret>"

# specs/012-bootstrap-system-admin-seed. Read ONLY by
# `scripts/seed-system-admin.ts` (run once per new environment, never by the
# running application — see env.validation.ts's own note on why
# DATABASE_URL follows the same separation) — deliberately NOT part of
# env.validation.ts's app-wide schema. All four are required; the script
# fails loudly and creates nothing if any is missing (research.md §4). The
# raw password is used only transiently to compute its Argon2id hash — never
# logged, never persisted, never written back to any file. Set these as
# real per-environment secrets (from a secret manager in staging/prod, a
# local .env value only in dev) — never reuse the same values across
# environments, and never commit a real value here.
BOOTSTRAP_ADMIN_NAME="<system admin's display name>"
BOOTSTRAP_ADMIN_USERNAME="<system admin's login username>"
BOOTSTRAP_ADMIN_EMAIL="<system admin's email>"
BOOTSTRAP_ADMIN_PASSWORD="<a strong, per-environment initial password>"

PORT=3000
