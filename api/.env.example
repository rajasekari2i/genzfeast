# Copy to .env and fill in real values for your environment. Never commit
# .env (coding_standard.md §10) — the repo's root .gitignore excludes it.
DATABASE_URL="postgresql://<superuser>:<password>@<host>:<port>/<database>?schema=public"

# A non-superuser, non-table-owning role the Node API (and RLS tests) connect
# as — RLS is meaningless against a superuser or the table owner, both of
# which bypass it entirely. Created by the initial migration as `app_user`.
APP_DATABASE_URL="postgresql://<app_role>:<app_role_password>@<host>:<port>/<database>?schema=public"
