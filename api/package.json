{
  "name": "genzfeast-api",
  "version": "0.1.0",
  "private": true,
  "description": "GenzFeast backend API (NestJS + TypeScript + Prisma)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postprisma:migrate:deploy": "npm run seed:system-admin:dev",
    "mint-dev-jwt": "ts-node scripts/mint-dev-jwt.ts",
    "seed:system-admin": "ts-node scripts/seed-system-admin.ts",
    "seed:system-admin:dev": "ts-node scripts/seed-system-admin-dev.ts",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:rls": "jest --selectProjects integration --testPathPattern=test/rls",
    "test:contract": "jest --selectProjects integration --testPathPattern=test/contract --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.115.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.3.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.10",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
